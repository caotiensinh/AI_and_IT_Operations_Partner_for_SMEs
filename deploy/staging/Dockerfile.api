FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e . 'uvicorn>=0.30,<1'
COPY deploy/staging/api_entry.py ./api_entry.py
RUN useradd --system --uid 10001 sme
USER sme
EXPOSE 8000
CMD ["uvicorn","api_entry:app","--host","0.0.0.0","--port","8000","--no-access-log"]
